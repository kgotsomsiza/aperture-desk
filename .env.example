# Alpaca paper trading credentials.
# Create a paper account at https://alpaca.markets and generate API keys.
ALPACA_API_KEY=PK_your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here

# Paper is the default. Never set this to true for this project.
ALPACA_LIVE_TRADE=false

# Options market data feed: "indicative" on the free plan, "opra" with a paid plan.
APERTURE_OPTIONS_FEED=indicative

# Reasoning layer. Featherless AI is the hackathon technology partner and is
# preferred when configured; OpenAI is the fallback; with neither, the desk runs
# its deterministic strategies and skips narration.
APERTURE_LLM_VENDOR=featherless
FEATHERLESS_API_KEY=your_key_here
APERTURE_FEATHERLESS_FAST=Qwen/Qwen3-Next-80B-A3B-Instruct
APERTURE_FEATHERLESS_REASONING=moonshotai/Kimi-K2-Instruct

OPENAI_API_KEY=your_key_here
